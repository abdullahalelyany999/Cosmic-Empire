const ctx = canvas.getContext("2d");

const galaxyCanvas = $("galaxyCanvas");
const galaxyCtx = galaxyCanvas.getContext("2d");

let coins = 900;
let tool = "select";
let selected = 0;
let nextId = 1;
let noticeTimer = null;
let galaxyAnimId = null;

let camZoom = 1.0;
let camAngleOffset = 0.0;
let selectedEnemy = null;

let rankIndex = 0;
let playerXp = 0;
let totalKills = 0;

const militaryRanks = [
  {title: "جندي فضاء متدرب", badge: "🎖️", xpRequired: 0, rewardCoins: 0},
  {title: "ملازم أول فلكي", badge: "⭐", xpRequired: 150, rewardCoins: 200},
  {title: "قائد سرب فضائي", badge: "🌟", xpRequired: 350, rewardCoins: 400},
  {title: "جنرال المجرة", badge: "🌠", xpRequired: 700, rewardCoins: 750},
  {title: "مارشال أسطول النجوم", badge: "🏅", xpRequired: 1200, rewardCoins: 1200},
  {title: "إمبراطور الكون الأبدي", badge: "👑", xpRequired: 2000, rewardCoins: 2500},
  {title: "سيد الأكوان المطلق", badge: "🌌", xpRequired: 3500, rewardCoins: 5000}
];

let approachingEnemies = [];
let playerProjectiles = [];

let itemLevels = {
  meteor: 1, bomb: 1, supernova: 1, antimatter: 1, blackhole: 1,
  shield: 1, satellite: 1, repair: 1, water: 1
};

const weaponsCatalog = [
  {id:"meteor",name:"صاروخ نيزكي مدمر",icon:"☄️",basePrice:35,scale:1.4,desc:"يقضي على الخصم فوراً"},
  {id:"bomb",name:"قنبلة النجم القاتلة",icon:"💥",basePrice:70,scale:1.5,desc:"انفجار مدمر فوري"},
  {id:"supernova",name:"مدفع السوبرنوفا",icon:"🌟",basePrice:150,scale:1.6,desc:"موجة طاقة قاضية"},
  {id:"antimatter",name:"صاروخ المادة المضادة",icon:"☢️",basePrice:240,scale:1.7,desc:"إبادة فورية للخصم"},
  {id:"blackhole",name:"نبضة الثقب الأسود",icon:"🌀",basePrice:380,scale:1.8,desc:"تمتص وتنهي الخصم تماماً"}
];

const shopItems = [
  {id:"shield",name:"مولد درع سيادي",icon:"🛡️",price:50,desc:"درع طاقي فائق"},
  {id:"satellite",name:"قمر صناعي حربي",icon:"🛰️",price:75,desc:"قمر دفاعي أوتوماتيكي"},
  {id:"repair",name:"حزمة إصلاح فوري",icon:"🔧",price:25,desc:"إصلاح العوالم"},
  {id:"water",name:"مولد محيطات",icon:"🌊",price:45,desc:"زيادة المياه"}
];

let inventory = { meteor:5, bomb:3, supernova:2, antimatter:1, blackhole:1, shield:1, satellite:1, repair:1, water:1 };
let planets = [];

function makePlanet(name,color,terrain,size,temp,atmosphere,water){
  return {
    id:nextId++,name,color,terrain,size,temp,gravity:100,
    atmosphere,water,shield:0,satellites:0,satellitesHealth:100,health:100,
    x:0,y:0,phase:Math.random()*6.28,rotation:0,destroyed:false
  };
}

function claimBonusCoins(){
  coins += 150;
  renderCoins();
  saveGame();
  toast("🎁 حصلت على منحة الإمبراطور 150 كوينز!");
  log("استلام منحة إمبراطورية لدعم الخزينة.");
}

function resetGameCompletely(){
  if(confirm("هل أنت متأكد من رغبتك في فرمتة اللعبة بالكامل؟")){
    localStorage.removeItem("cosmicWarSaveProfileRankSystem");
    location.reload();
  }
}

function completeIntro(){
  const name = $("initName").value.trim() || "أوريون الأسطوري";
  const size = +$("initSize").value;
  const temp = +$("initTemp").value;
  const gravity = +$("initGravity").value;
  const atmosphere = +$("initAtmosphere").value;
  const water = +$("initWater").value;
  const color = $("initColor").value;
  const terrain = $("initTerrain").value;

  const firstPlanet = makePlanet(name, color, terrain, size, temp, atmosphere, water);
  firstPlanet.gravity = gravity;
  planets.push(firstPlanet);
  selected = firstPlanet.id;

  $("introOverlay").classList.add("hidden");
  saveGame();
  syncEditor();
  renderCards();
  renderShop();
  renderWeaponsShop();
  renderInventoryModal();
  renderMissions();
  renderCoins();
  updateProfileUI();
  resize();
  requestAnimationFrame(draw);
  
  log("بدء المعارك مع كوكب: " + firstPlanet.name);
  toast("⚔️ تم تفعيل نظام الرتب العسكرية! افتح الملف الشخصي لمتابعة رتبتك.");
  
  setInterval(spawnApproachingEnemy, Math.random() * 15000 + 15000);
}

function spawnApproachingEnemy(){
  if(planets.length === 0) return;
  const target = planets[Math.floor(Math.random()*planets.length)];
  if(target.destroyed) return;

  let startX = Math.random() > 0.5 ? -40 : cw + 40;
  let startY = Math.random() * ch;

  let enemy = {
    id: Math.random(),
    x: startX,
    y: startY,
    targetPlanetId: target.id,
    color: "#fb7185",
    size: 22,
    state: "approaching",
    timer: 0
  };

  approachingEnemies.push(enemy);
  $("enemyCount").textContent = approachingEnemies.length;
  log("⚠️ رادار الفضاء: ظهور عدو جديد في القطاع");
  toast("🚨 كوكب معادي يقترب! افتح مستودعك واقضِ عليه فوراً!");
}

function openProfileModal(){
  $("profileModal").classList.remove("hidden");
  updateProfileUI();
}

function closeProfileModal(){
  $("profileModal").classList.add("hidden");
}

function updateProfileUI(){
  const currentRank = militaryRanks[rankIndex] || militaryRanks[militaryRanks.length - 1];
  const nextRank = militaryRanks[rankIndex + 1];

  $("profileBadge").textContent = currentRank.badge;
  $("profileCommanderName").textContent = (planets[0] ? planets[0].name : "القائد") + " (الإمبراطورية)";
  $("profileRankTitle").textContent = currentRank.title;
  $("currentRankDisplay").textContent = currentRank.title;

  $("statKills").textContent = totalKills;
  $("statPlanetsCount").textContent = planets.length;
  $("statRankLevel").textContent = (rankIndex + 1) + " / " + militaryRanks.length;
  $("statCoinsCount").textContent = coins;

  if(nextRank){
    let currentReq = currentRank.xpRequired;
    let targetReq = nextRank.xpRequired;
    let progressInLevel = Math.max(0, playerXp - currentReq);
    let neededForLevel = targetReq - currentReq;
    let percent = Math.min(100, Math.floor((progressInLevel / neededForLevel) * 100));

    $("profileXp").textContent = playerXp;
    $("profileTargetXp").textContent = targetReq;
    $("profileProgressBar").style.width = percent + "%";
    
    let remaining = Math.max(0, targetReq - playerXp);
    $("profileRemainingText").textContent = "باقي لك " + remaining + " نقطة خبرة (XP) للترقية إلى رتبة: " + nextRank.title;

    if(playerXp >= targetReq){
      $("upgradeRankBtn").disabled = false;
      $("upgradeRankBtn").textContent = "⭐ رقي رتبتك الآن وحصل على مكافأة!";
    } else {
      $("upgradeRankBtn").disabled = true;
      $("upgradeRankBtn").textContent = "🔒 جمع نقاط خبرة كافية للترقية";
    }
  } else {
    $("profileXp").textContent = playerXp;
    $("profileTargetXp").textContent = "ماكس";
    $("profileProgressBar").style.width = "100%";
    $("profileRemainingText").textContent = "لقد وصلت إلى أعلى رتبة إمبراطورية مطلقة في الكون!";
    $("upgradeRankBtn").disabled = true;
    $("upgradeRankBtn").textContent = "👑 رتبتك في القمة المطلقة";
  }
}

function tryUpgradeRank(){
  const nextRank = militaryRanks[rankIndex + 1];
  if(!nextRank || playerXp < nextRank.xpRequired) return;

  rankIndex++;
  let rewardVal = nextRank.rewardCoins;
  coins += rewardVal;
  renderCoins();
  updateProfileUI();
  
  toast("🎖️ مبروك! تمت ترقيتك إلى رتبة: " + nextRank.title + " وحصلت على +" + rewardVal + " كوينز!");
  log("ترقية الرتبة العسكرية إلى: " + nextRank.title);
  saveGame();
}

function openWeaponsModal(){
  $("weaponsModal").classList.remove("hidden");
  renderWeaponsShop();
}

function closeWeaponsModal(){
  $("weaponsModal").classList.add("hidden");
}

function openInventoryModal(){
  $("inventoryModal").classList.add("hidden");
  $("inventoryModal").classList.remove("hidden");
  renderInventoryModal();
}

function closeInventoryModal(){
  $("inventoryModal").classList.add("hidden");
}

function renderInventoryModal(){
  const container = $("inventoryListContainer");
  if(!container) return;
  container.replaceChildren();

  const allItems = [...weaponsCatalog, ...shopItems];

  allItems.forEach(item => {
    let count = inventory[item.id] || 0;
    let currentLevel = itemLevels[item.id] || 1;
    let upgradeCost = currentLevel * 60;

    let row = document.createElement("div");
    row.className = "item";

    let icon = document.createElement("div");
    icon.className = "item-icon";
    icon.textContent = item.icon;

    let info = document.createElement("div");
    info.className = "item-info";

    let title = document.createElement("b");
    title.textContent = item.name + " (مستوى " + currentLevel + ")";

    let desc = document.createElement("small");
    let details = "الكمية: " + count + " | ";
    if(item.basePrice){
      details += "تدمير فوري بطلقة واحدة";
    } else {
      details += "كفاءة الدعم";
    }
    details += " | ترقية: " + upgradeCost + " 🪙";
    desc.textContent = details;
    desc.style.color = count > 0 ? "var(--green)" : "#94a3b8";

    info.append(title, desc);

    let btnWrap = document.createElement("div");
    btnWrap.style.display = "flex";
    btnWrap.style.gap = "4px";
    btnWrap.style.flexWrap = "wrap";

    let upBtn = document.createElement("button");
    upBtn.textContent = "⭐ ترقية";
    upBtn.style.background = "linear-gradient(135deg,#065f46,#047857)";
    upBtn.onclick = () => {
      if(coins < upgradeCost){
        toast("الكوينز غير كافية للترقية!");
        return;
      }
      spend(upgradeCost);
      itemLevels[item.id]++;
      toast("⭐ تمت ترقية " + item.name + " إلى مستوى " + itemLevels[item.id] + "!");
      log("ترقية " + item.name + " إلى مستوى " + itemLevels[item.id]);
      renderInventoryModal();
      saveGame();
    };

    btnWrap.append(upBtn);

    let fireBtn = document.createElement("button");
    if(item.basePrice){
      fireBtn.textContent = "🚀 إطلاق للقتل الفوري";
      fireBtn.style.background = "linear-gradient(135deg,#991b1b,#dc2626)";
      fireBtn.onclick = () => instantKillEnemy(item.id);
      if(count <= 0) fireBtn.disabled = true;
    } else {
      fireBtn.textContent = "✨ تفعيل الأداة";
      fireBtn.style.background = "linear-gradient(135deg,#1e40af,#3b82f6)";
      fireBtn.onclick = () => useUtilityFromInventory(item.id, currentLevel);
    }

    btnWrap.append(fireBtn);
    row.append(icon, info, btnWrap);
    container.append(row);
  });
}

function instantKillEnemy(weaponId){
  let count = inventory[weaponId] || 0;
  if(count <= 0){
    toast("نفذ هذا السلاح من مستودعك! اشترِ من الترسانة.");
    return;
  }

  if(approachingEnemies.length === 0){
    toast("لا توجد بوتات أو أعداء في الشاشة حالياً!");
    return;
  }

  let targetEnemy = selectedEnemy || approachingEnemies[0];

  inventory[weaponId]--;
  renderInventoryModal();
  closeInventoryModal();

  approachingEnemies = approachingEnemies.filter(en => en.id !== targetEnemy.id);
  selectedEnemy = null;
  $("enemyCount").textContent = approachingEnemies.length;

  totalKills++;
  playerXp += 50;

  let targetPlanet = planets.find(p => p.id === targetEnemy.targetPlanetId) || activePlanet();
  if(targetPlanet){
    targetPlanet.health = Math.min(100, targetPlanet.health + 40);
    targetPlanet.destroyed = false;
    syncStats();
    renderCards();
  }

  burst(targetEnemy.x, targetEnemy.y, 70, "#38bdf8");
  reward(100, "💥 تم القضاء على البوت واكتساب +50 XP للرتبة!");
  log("تم تدمير بوت معادي واكتساب نقاط خبرة للرتبة العسكرية.");
  updateProfileUI();
  saveGame();
}

function useUtilityFromInventory(utilityId, lvl){
  let count = inventory[utilityId] || 0;
  if(utilityId !== "shield" && utilityId !== "repair" && count <= 0){
    toast("نفذت هذه الأداة!");
    return;
  }
  let p = activePlanet();
  if(utilityId === "shield"){
    let shieldBoost = lvl * 40;
    p.shield = Math.min(100, p.shield + shieldBoost);
    toast("🛡️ تم تفعيل درع الحماية الفائق!");
  } else if(utilityId === "satellite"){
    inventory.satellite--;
    p.satellites = (p.satellites || 0) + 1;
    toast("🛰️ تم نشر قمر حربي دفاعي!");
  } else if(utilityId === "repair"){
    p.health = 100;
    p.destroyed = false;
    toast("🔧 تم إصلاح الكوكب بالكامل!");
  } else if(utilityId === "water"){
    inventory.water--;
    p.water = Math.min(100, p.water + 30);
    toast("🌊 تم توليد المحيطات!");
  }
  renderInventoryModal();
  syncStats();
  renderCards();
  saveGame();
}

function getWeaponPrice(w){
  let owned = inventory[w.id] || 0;
  return Math.round(w.basePrice * Math.pow(w.scale, owned));
}

function renderWeaponsShop(){
  const container = $("weaponsListContainer");
  if(!container) return;
  container.replaceChildren();

  weaponsCatalog.forEach(w => {
    let currentPrice = getWeaponPrice(w);
    let row = document.createElement("div");
    row.className = "item";

    let icon = document.createElement("div");
    icon.className = "item-icon";
    icon.textContent = w.icon;

    let info = document.createElement("div");
    info.className = "item-info";

    let title = document.createElement("b");
    title.textContent = w.name;

    let desc = document.createElement("small");
    desc.textContent = w.desc + " | قتل فوري | لديك: " + (inventory[w.id] || 0);

    let price = document.createElement("small");
    price.textContent = "السعر: " + currentPrice + " 🪙";
    price.style.color = "var(--red)";

    info.append(title, desc, price);

    let btn = document.createElement("button");
    btn.textContent = "شراء";
    btn.onclick = () => buyWeapon(w);

    row.append(icon, info, btn);
    container.append(row);
  });
}

function buyWeapon(w){
  let price = getWeaponPrice(w);
  spend(price);
  inventory[w.id] = (inventory[w.id] || 0) + 1;
  renderWeaponsShop();
  renderInventoryModal();
  toast("تم شراء سلاح: " + w.name);
  log("شراء عتاد: " + w.name);
  saveGame();
}

function openGalaxyModal(){
  $("galaxyModal").classList.remove("hidden");
  resizeGalaxyCanvas();
  runGalaxy3DAnimation();
}

function closeGalaxyModal(){
  $("galaxyModal").classList.add("hidden");
  if(galaxyAnimId) cancelAnimationFrame(galaxyAnimId);
}

function adjustCamera(action){
  if(action === "zoomIn") camZoom = Math.min(2.2, camZoom + 0.2);
  if(action === "zoomOut") camZoom = Math.max(0.6, camZoom - 0.2);
  if(action === "rotateLeft") camAngleOffset -= 0.3;
  if(action === "rotateRight") camAngleOffset += 0.3;
  toast("تم تعديل زاوية الكاميرا");
}

function resizeGalaxyCanvas(){
  const rect = galaxyCanvas.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio||1,2);
  galaxyCanvas.width = Math.round(rect.width * dpr);
  galaxyCanvas.height = Math.round(rect.height * dpr);
  galaxyCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function runGalaxy3DAnimation(now = 0){
  const rect = galaxyCanvas.getBoundingClientRect();
  const gw = rect.width;
  const gh = rect.height;

  galaxyCtx.clearRect(0, 0, gw, gh);
  galaxyCtx.fillStyle = "#010409";
  galaxyCtx.fillRect(0, 0, gw, gh);

  galaxyCtx.fillStyle = "#ffffff";
  for(let i=0; i<90; i++){
    let sx = (i * 37) % gw;
    let sy = (i * 59) % gh;
    galaxyCtx.globalAlpha = 0.3 + 0.5 * Math.sin(now * 0.001 + i);
    galaxyCtx.fillRect(sx, sy, 1.5, 1.5);
  }
  galaxyCtx.globalAlpha = 1;

  if(planets.length > 0){
    const centerPlanet = activePlanet() || planets[0];
    const cx = gw / 2;
    const cy = gh / 2;

    galaxyCtx.save();
    galaxyCtx.translate(cx, cy);
    galaxyCtx.scale(camZoom, camZoom);
    galaxyCtx.rotate(camAngleOffset);
    galaxyCtx.translate(-cx, -cy);

    const radialGrad = galaxyCtx.createRadialGradient(cx, cy, 15, cx, cy, 140);
    radialGrad.addColorStop(0, centerPlanet.color || "#38bdf8");
    radialGrad.addColorStop(1, "transparent");
    galaxyCtx.fillStyle = radialGrad;
    galaxyCtx.beginPath();
    galaxyCtx.arc(cx, cy, 140, 0, Math.PI*2);
    galaxyCtx.fill();

    galaxyCtx.beginPath();
    galaxyCtx.arc(cx, cy, 45, 0, Math.PI*2);
    galaxyCtx.fillStyle = centerPlanet.color || "#38bdf8";
    galaxyCtx.fill();
    galaxyCtx.lineWidth = 3;
    galaxyCtx.strokeStyle = "var(--purple)";
    galaxyCtx.stroke();

    galaxyCtx.fillStyle = "#fff";
    galaxyCtx.font = "bold 13px Tahoma";
    galaxyCtx.textAlign = "center";
    galaxyCtx.fillText("⭐ " + centerPlanet.name + " [المركز الإمبراطوري]", cx, cy + 65);

    const otherPlanets = planets.filter(p => p.id !== centerPlanet.id);
    const count = otherPlanets.length;

    otherPlanets.forEach((p, idx) => {
      let angle = (now * 0.0006) + (idx * ((Math.PI * 2) / Math.max(1, count)));
      let rx = 145;
      let ry = 72;
      let px = cx + Math.cos(angle) * rx;
      let py = cy + Math.sin(angle) * ry;

      galaxyCtx.beginPath();
      galaxyCtx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI*2);
      galaxyCtx.strokeStyle = "rgba(129, 140, 248, 0.2)";
      galaxyCtx.lineWidth = 1.2;
      galaxyCtx.stroke();

      galaxyCtx.beginPath();
      galaxyCtx.arc(px, py, 22, 0, Math.PI*2);
      galaxyCtx.fillStyle = p.color || "#fb7185";
      galaxyCtx.fill();
      galaxyCtx.lineWidth = 2;
      galaxyCtx.strokeStyle = p.destroyed ? "var(--red)" : "var(--green)";
      galaxyCtx.stroke();

      galaxyCtx.fillStyle = "#f1f5f9";
      galaxyCtx.font = "11px Tahoma";
      galaxyCtx.fillText(p.name, px, py + 35);
    });

    galaxyCtx.restore();
  }

  galaxyAnimId = requestAnimationFrame(runGalaxy3DAnimation);
}

function startExpedition(){
  if(!spend(25)) return;
  toast("🛰️ انطلقت بعثة التنقيب نحو أعماق المجرة...");
  setTimeout(() => {
    const earned = 90 + Math.floor(Math.random()*80);
    reward(earned, "نجاح البعثة التنقيبية!");
    playerXp += 30;
    updateProfileUI();
    log("عادت بعثة التنقيب محملة بـ " + earned + " كوينز و +30 XP.");
    saveGame();
  }, 3000);
}

function log(message){
  const box=$("log");
  const line=document.createElement("div");
  line.textContent="› "+message;
  box.prepend(line);
  while(box.children.length>18)box.lastChild.remove();
}

function toast(message){
  $("notice").textContent=message;
  $("notice").classList.remove("hidden");
  clearTimeout(noticeTimer);
  noticeTimer=setTimeout(()=>$("notice").classList.add("hidden"),2500);
}

function spend(amount){
  if(coins < amount){
    claimBonusCoins();
  }
  coins -= amount;
  renderCoins();
  updateProfileUI();
  saveGame();
  return true;
}

function renderCoins(){
  $("coins").textContent=coins;
  updateProfileUI();
}

function reward(amount,message){
  coins+=amount;
  renderCoins();
  toast(message+" +"+amount+" 🪙");
  saveGame();
}

function activePlanet(){
  return planets.find(p=>p.id===selected) || planets[0];
}

function renderShop(){
  $("shop").replaceChildren();
  shopItems.forEach(item=>{
    const row=document.createElement("div");
    row.className="item";
    const icon=document.createElement("div");
    icon.className="item-icon";icon.textContent=item.icon;
    const info=document.createElement("div");info.className="item-info";
    const title=document.createElement("b");title.textContent=item.name;
    const desc=document.createElement("small");desc.textContent=item.desc;
    const price=document.createElement("small");price.textContent=item.price+" 🪙";
    info.append(title,desc,price);
    const btn=document.createElement("button");btn.textContent="شراء";
    btn.onclick=()=>buyShopItem(item);
    row.append(icon,info,btn);$("shop").append(row);
  });
}

function buyShopItem(item){
  spend(item.price);
  inventory[item.id]=(inventory[item.id]||0)+1;
  renderInventoryModal();
  toast("تم شراء "+item.name);
  log("شراء أداة تطوير: "+item.name);
  saveGame();
}

function createPlanet(){
  if(planets.length>=12){toast("وصلت للحد الأقصى: 12 مستعمرة.");return}
  spend(100);
  const p=makePlanet("مستعمرة "+(planets.length+1),"#"+Math.floor(Math.random()*16777215).toString(16).padStart(6,"0"),"earth",65,22,70,55);
  planets.push(p);selected=p.id;
  syncEditor();renderCards();
  log("تم بناء مستعمرة جديدة: "+p.name);
  toast("أهلاً بالمستعمرة الفضائية الجديدة!");
  updateProfileUI();
  saveGame();
}

function randomPlanet(){
  const terrains=["earth","desert","ice","lava","alien"];
  const colors=["#38bdf8","#fb7185","#34d399","#fbbf24","#818cf8","#f43f5e"];
  $("planetName").value=["نوفا بريم","أتلانتس","زهار","هيليوس","فورتكس"][Math.floor(Math.random()*5)];
  $("size").value=30+Math.floor(Math.random()*71);
  $("temp").value=-100+Math.floor(Math.random()*450);
  $("gravity").value=50+Math.floor(Math.random()*200);
  $("atmosphere").value=Math.floor(Math.random()*101);
  $("water").value=Math.floor(Math.random()*101);
  $("planetColor").value=colors[Math.floor(Math.random()*colors.length)];
  $("terrain").value=terrains[Math.floor(Math.random()*terrains.length)];
  if(!activePlanet()){toast("أنشئ مستعمرة أولاً.");return}
  updatePlanet();renamePlanet();
}

function renamePlanet(){
  const p=activePlanet();
  if(!p)return;
  p.name=$("planetName").value.trim()||"عالم مجهول";
  $("planetName").value=p.name;
  renderCards();syncStats();
  saveGame();
}

function updatePlanet(){
  const p=activePlanet();if(!p)return;
  p.size=+$("size").value;
  p.temp=+$("temp").value;
  p.gravity=+$("gravity").value;
  p.atmosphere=+$("atmosphere").value;
  p.water=+$("water").value;
  p.color=$("planetColor").value;
  p.terrain=$("terrain").value;
  $("sizeVal").textContent=p.size;
  $("tempVal").textContent=p.temp+"°C";
  $("gravVal").textContent=(p.gravity/100).toFixed(1)+"x";
  $("atmVal").textContent=p.atmosphere+"%";
  $("waterVal").textContent=p.water+"%";
  syncStats();renderCards();
  saveGame();
}

function syncEditor(){
  const p=activePlanet();if(!p)return;
  $("planetName").value=p.name;
  $("size").value=p.size;$("temp").value=p.temp;
  $("gravity").value=p.gravity;$("atmosphere").value=p.atmosphere;
  $("water").value=p.water;$("planetColor").value=p.color;
  $("terrain").value=p.terrain;
  updatePlanet();
}

function syncStats(){
  const p=activePlanet();if(!p)return;
  $("selectedName").textContent=p.name;
  $("statSize").textContent=p.size;
  $("statTemp").textContent=p.temp+"°C";
  $("statWater").textContent=p.water+"%";
  $("statShield").textContent=p.shield+"% (أقمار: "+p.satellites+")";
  $("shieldText").textContent=p.shield?"درع نشط بنسبة "+p.shield+"%":"غير محمي حالياً";
  $("shieldBar").style.width=p.shield+"%";
}

function renderCards(){
  $("planetCards").replaceChildren();
  planets.forEach(p=>{
    const card=document.createElement("div");
    card.className="planet-card"+(p.id===selected?" active":"");
    const orb=document.createElement("div");orb.className="mini-planet";
    orb.style.background=planetGradient(p);
    const name=document.createElement("div");name.className="card-title";name.textContent=p.name;
    const health=document.createElement("small");health.textContent="السلامة: "+p.health+"%";
    card.append(orb,name,health);
    card.onclick=()=>{selected=p.id;syncEditor();renderCards()};
    $("planetCards").append(card);
  });
}

const missions=[
 {id:"create",name:"مرحلة التأسيس الحربي",desc:"أنشئ 3 مستعمرات",goal:3,progress:1,reward:250},
 {id:"protect",name:"درع السيادة المطلقة",desc:"فعّل درعين للدفاع",goal:2,progress:0,reward:300},
 {id:"explore",name:"استكشاف القطاعات",desc:"أكمل 4 بعثات تنقيب",goal:4,progress:0,reward:350},
 {id:"shop",name:"شامخ ترسانة الإبادة",desc:"امتلك 3 أسلحة مدمرة",goal:3,progress:0,reward:400}
];

function renderMissions(){
  $("missions").replaceChildren();
  missions.forEach(m=>{
    const done=m.progress>=m.goal;
    const row=document.createElement("div");row.className="item";
    const info=document.createElement("div");info.className="item-info";
    const title=document.createElement("b");title.textContent=(done?"✅ ":"🎯 ")+m.name;
    const desc=document.createElement("small");desc.textContent=m.desc+" · "+Math.min(m.progress,m.goal)+"/"+m.goal;
    const bar=document.createElement("div");bar.className="progress";
    const fill=document.createElement("div");fill.style.width=Math.min(100,m.progress/m.goal*100)+"%";
    bar.append(fill);info.append(title,desc,bar);
    const btn=document.createElement("button");btn.textContent=done?(m.claimed?"مكتمل":"استلام مكافأة"):"+"+m.reward;
    btn.disabled=!done||m.claimed;
    btn.onclick=()=>{
      if(!done||m.claimed)return;
      m.claimed=true;
      reward(m.reward,"مكافأة المهمة الحربية المنجزة!");
      playerXp += 100;
      updateProfileUI();
      toast("⭐ إنجاز عظيم! اكتسبت +100 نقطة خبرة XP!");
      log("إنجاز المهمة واكتساب نقاط خبرة.");
      renderMissions();
      saveGame();
    };
    row.append(info,btn);$("missions").append(row);
  });
}

function advanceMission(id,amount=1){
  const m=missions.find(m=>m.id===id);
  if(m&&!m.claimed)m.progress=Math.min(m.goal,m.progress+amount);
  renderMissions();
  saveGame();
}

function setTool(t){
  tool=t;
  const names={
    select:"اختر مستعمرة لتعديلها.",
    meteor:"إطلاق صاروخ نيزكي.",
    bomb:"قنبلة النجم المدمرة.",
    shield:"تفعيل درع طاقي.",
    satellite:"نشر قمر صناعي حربي دفاعي.",
    repair:"إصلاح المستعمرة."
  };
  $("toolHint").textContent=names[t]||"";
  toast("الأداة المختارة: "+t);
}

function useTool(p){
  if(tool==="select"){selected=p.id;syncEditor();renderCards();return}
  if(tool==="shield"){
    spend(40);
    p.shield=Math.min(100,p.shield+40);
    advanceMission("protect");
    log("تفعيل درع طاقي لـ "+p.name);
  }
  else if(tool==="satellite"){
    spend(60);
    p.satellites=(p.satellites||0)+1;
    p.satellitesHealth = 100;
    log("🛰️ نشر قمر صناعي حربي حول "+p.name);
    toast("تم نشر القمر الحربي بنجاح!");
  }
  else if(tool==="repair"){
    spend(25);
    p.health=100;p.destroyed=false;
    log("إصلاح مستعمرة "+p.name);
  }
  syncStats();renderCards();draw();
  saveGame();
}

function protectPlanet(){
  const p=activePlanet();
  spend(40);
  p.shield=Math.min(100,p.shield+40);
  advanceMission("protect");
  syncStats();renderCards();log("تدريع "+p.name);
  toast("تم تعزيز الدرع الإمبراطوري!");
  saveGame();
}

function repairAll(){
  const p=planets.filter(p=>p.health<100||p.destroyed);
  if(!p.length){toast("كافة المستعمرات في حالة مثالية!");return}
  spend(p.length*25);
  p.forEach(x=>{x.health=100;x.destroyed=false});
  syncStats();renderCards();toast("تم إصلاح كافة مستعمرات الإمبراطورية");
  log("إصلاح شامل لجميع العوالم.");
  saveGame();
}

function planetGradient(p){
  const c=p.color||"#38bdf8";
  if(p.terrain==="lava")return "radial-gradient(circle at 30% 30%,#fed7aa,"+c+" 42%,#7c2d12 78%,#020617)";
  if(p.terrain==="ice")return "radial-gradient(circle at 30% 30%,#fff,"+c+" 45%,#475569 80%,#020617)";
  if(p.terrain==="desert")return "radial-gradient(circle at 30% 30%,#fef08a,"+c+" 50%,#78350f 85%,#020617)";
  if(p.terrain==="alien")return "radial-gradient(circle at 30% 30%,#f5d0fe,"+c+" 48%,#581c87 82%,#020617)";
  return "radial-gradient(circle at 30% 28%,#e0f2fe,"+c+" 43%,#0369a1 76%,#020617)";
}

let stars=[];
let particles=[];
let cw=0,ch=0,dpr=1;

function resize(){
  const rect=canvas.getBoundingClientRect();
  dpr=Math.min(window.devicePixelRatio||1,2);
  cw=rect.width;ch=rect.height;
  canvas.width=Math.round(cw*dpr);canvas.height=Math.round(ch*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);
  stars=Array.from({length:Math.min(240,Math.floor(cw*ch/1400))},()=>({
    x:Math.random()*cw,y:Math.random()*ch,
    r:Math.random()*1.5+.2,phase:Math.random()*6.28
  }));
  positionPlanets();
}

function positionPlanets(){
  if(!cw||!ch)return;
  planets.forEach((p,i)=>{
    const col=i%3,row=Math.floor(i/3);
    const n=Math.min(planets.length,3);
    p.x=cw*(n===1?.5:(col+.5)/n);
    p.y=ch*(row===0?.52:.28+row*.32);
  });
}

function burst(x,y,count,color){
  for(let i=0;i<count;i++){
    const a=Math.random()*Math.PI*2,s=Math.random()*3.5+1;
    particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,
      life:35+Math.random()*30,max:65,color,r:Math.random()*3+1});
  }
}

function drawPlanet(p){
  const r=p.size*.62;
  p.rotation+=.002;
  const grad=ctx.createRadialGradient(p.x-r*.35,p.y-r*.42,r*.04,p.x,p.y,r*1.15);
  grad.addColorStop(0,p.color);
  grad.addColorStop(.6,p.color);
  grad.addColorStop(1,"#020617");

  ctx.save();
  ctx.translate(p.x,p.y);
  ctx.rotate(p.rotation*.12);

  if(p.atmosphere>0){
    ctx.beginPath();ctx.arc(0,0,r+5+p.atmosphere*.04,0,Math.PI*2);
    ctx.strokeStyle=p.color;ctx.globalAlpha=.08+p.atmosphere/250;
    ctx.lineWidth=2+p.atmosphere/22;ctx.stroke();ctx.globalAlpha=1;
  }

  if(p.water>0){
    ctx.beginPath();ctx.ellipse(0,0,r*.94,r*.35,-.35,0,Math.PI*2);
    ctx.strokeStyle="#38bdf8";ctx.globalAlpha=p.water/180;
    ctx.lineWidth=Math.max(1,p.water/28);ctx.stroke();ctx.globalAlpha=1;
  }

  ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);
  ctx.fillStyle=grad;ctx.fill();

  ctx.save();ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.clip();
  for(let i=0;i<8;i++){
    const yy=-r+i*r*.29;
    const ww=r*(.4+Math.abs(Math.sin(i*3.4+p.phase))*.55);
    ctx.beginPath();
    ctx.ellipse(Math.sin(i*7+p.phase)*r*.3,yy,ww,r*.09,Math.sin(i+p.phase),0,Math.PI*2);
    const colors={
      earth:"#34d399",desert:"#fbbf24",ice:"#e0f2fe",
      lava:"#f43f5e",alien:"#c084fc"
    };
    ctx.fillStyle=colors[p.terrain]||"#34d399";
    ctx.globalAlpha=.13+(i%3)*.07;ctx.fill();
  }
  ctx.globalAlpha=1;ctx.restore();

  if(p.satellites > 0){
    for(let s=0; s<p.satellites; s++){
      let sa = (Date.now()*0.002) + (s * (Math.PI*2 / p.satellites));
      let sx = Math.cos(sa) * (r + 14);
      let sy = Math.sin(sa) * (r + 14);
      ctx.beginPath();ctx.arc(sx, sy, 3.5, 0, Math.PI*2);
      ctx.fillStyle = "var(--green)";ctx.fill();
    }
  }

  if(p.shield>0){
    ctx.beginPath();ctx.arc(0,0,r+8,0,Math.PI*2);
    ctx.strokeStyle="var(--green)";ctx.globalAlpha=.35+p.shield/180;
    ctx.lineWidth=2+p.shield/50;ctx.stroke();ctx.globalAlpha=1;
  }

  if(p.destroyed){
    ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);
    ctx.fillStyle="#000b";ctx.fill();
    ctx.fillStyle="var(--red)";ctx.font="bold 12px Tahoma";
    ctx.textAlign="center";ctx.fillText("مدمر",0,4);
  }

  if(p.id===selected){
    ctx.beginPath();ctx.arc(0,0,r+14,0,Math.PI*2);
    ctx.strokeStyle="var(--cyan)";ctx.lineWidth=1.5;
    ctx.setLineDash([5,5]);ctx.stroke();ctx.setLineDash([]);
  }
  ctx.restore();

  ctx.fillStyle="#f1f5f9";ctx.font="12px Tahoma";
  ctx.textAlign="center";ctx.fillText(p.name,p.x,p.y+r+24);
  ctx.fillStyle="#94a3b8";ctx.font="10px Tahoma";
  ctx.fillText("سلامة "+p.health+"%",p.x,p.y+r+38);
}

function updateWarSimulation(){
  $("enemyCount").textContent = approachingEnemies.length;

  approachingEnemies.forEach(en => {
    let targetPlanet = planets.find(p => p.id === en.targetPlanetId);
    if(!targetPlanet || targetPlanet.destroyed) return;

    let dx = targetPlanet.x - en.x;
    let dy = targetPlanet.y - en.y;
    let dist = Math.hypot(dx, dy);

    if(dist > 55){
      en.x += (dx / dist) * 0.5;
      en.y += (dy / dist) * 0.5;
    } else {
      en.timer++;
      if(en.timer % 110 === 0){
        let attackDamage = 8 + (rankIndex * 2);
        if(targetPlanet.satellites > 0){
          targetPlanet.satellitesHealth -= 25;
          if(targetPlanet.satellitesHealth <= 0){
            targetPlanet.satellites--;
            targetPlanet.satellitesHealth = 100;
            log("⚠️ تم تدمير قمر حربي للدفاع عن " + targetPlanet.name);
            toast("💥 تدمير قمر حربي دفاعي!");
          }
        } else if(targetPlanet.shield > 0){
          targetPlanet.shield = Math.max(0, targetPlanet.shield - attackDamage);
        } else {
          targetPlanet.health = Math.max(0, targetPlanet.health - attackDamage);
          if(targetPlanet.health === 0) targetPlanet.destroyed = true;
          log("🔥 العدو يقصف " + targetPlanet.name + " بضرر " + attackDamage);
        }
        syncStats();
        renderCards();
        saveGame();
      }
    }
  });
}

function drawWarSimulation(){
  approachingEnemies.forEach(en => {
    let isSelected = (selectedEnemy && selectedEnemy.id === en.id);

    ctx.beginPath();
    ctx.arc(en.x, en.y, en.size, 0, Math.PI*2);
    ctx.fillStyle = isSelected ? "#38bdf8" : en.color;
    ctx.shadowColor = isSelected ? "#38bdf8" : "#fb7185";
    ctx.shadowBlur = isSelected ? 22 : 10;
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.fillStyle = "#fff";
    ctx.font = "10px Tahoma";
    ctx.textAlign = "center";
    ctx.fillText(isSelected ? "🎯 [الهدف المحدد]" : "⚠️ بوت معادي", en.x, en.y - en.size - 12);
  });
}

function draw(now=0){
  if(!cw||!ch)return;
  ctx.clearRect(0,0,cw,ch);
  ctx.fillStyle="#010409";ctx.fillRect(0,0,cw,ch);

  stars.forEach(s=>{
    const a=.3+.7*(.5+.5*Math.sin(now*.001+s.phase));
    ctx.globalAlpha=a;ctx.fillStyle="#e2e8f0";
    ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fill();
  });
  ctx.globalAlpha=1;

  planets.forEach(drawPlanet);

  updateWarSimulation();
  drawWarSimulation();

  particles=particles.filter(p=>p.life>0);
  particles.forEach(p=>{
    p.x+=p.vx;p.y+=p.vy;p.vx*=.98;p.vy*=.98;p.life--;
    ctx.globalAlpha=Math.max(0,p.life/p.max);
    ctx.fillStyle=p.color;ctx.beginPath();
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
  });
  ctx.globalAlpha=1;

  requestAnimationFrame(draw);
}

canvas.addEventListener("click",e=>{
  const rect=canvas.getBoundingClientRect();
  const x=e.clientX-rect.left,y=e.clientY-rect.top;

  let clickedEnemy = null;
  approachingEnemies.forEach(en => {
    if(Math.hypot(en.x - x, en.y - y) < en.size + 14){
      clickedEnemy = en;
    }
  });

  if(clickedEnemy){
    selectedEnemy = clickedEnemy;
    toast("🎯 تم تحديد كوكب العدو! افتح (أسلحتي) واضغط إطلاق للقتل الفوري.");
    log("تم تحديد هدف معادي جديد للاستهداف المباشر.");
    return;
  }

  let found=null,best=Infinity;
  planets.forEach(p=>{
    const d=Math.hypot(p.x-x,p.y-y);
    if(d<p.size*.7+12&&d<best){best=d;found=p}
  });
  if(found){
    selected=found.id;
    selectedEnemy = null;
    syncEditor();
    renderCards();
    toast("تم اختيار مستعمرتك: " + found.name);
  }
});

function saveGame(){
  const data={coins,planets,selected,nextId,inventory,missions,rankIndex,playerXp,totalKills,itemLevels};
  try{
    localStorage.setItem("cosmicWarSaveProfileRankSystem",JSON.stringify(data));
  }catch(e){}
}

function loadGame(){
  try{
    const raw=localStorage.getItem("cosmicWarSaveProfileRankSystem");
    if(!raw)return false;
    const d=JSON.parse(raw);
    if(!d||!Array.isArray(d.planets)||!d.planets.length)return false;
    coins=Number.isFinite(d.coins)?d.coins:900;
    planets=d.planets;selected=d.selected||planets[0].id;
    nextId=d.nextId||planets.length+1;
    rankIndex=Number.isFinite(d.rankIndex)?d.rankIndex:0;
    playerXp=Number.isFinite(d.playerXp)?d.playerXp:0;
    totalKills=Number.isFinite(d.totalKills)?d.totalKills:0;
    if(d.itemLevels) itemLevels={...itemLevels,...d.itemLevels};
    inventory={...inventory,...(d.inventory||{})};
    if(Array.isArray(d.missions)){
      d.missions.forEach(old=>{
        const m=missions.find(x=>x.id===old.id);
        if(m){m.progress=old.progress||0;m.claimed=!!old.claimed}
      });
    }
    return true;
  }catch(e){return false}
}

function init(){
  const hasSave = loadGame();
  if(hasSave){
    $("introOverlay").classList.add("hidden");
    renderCoins();renderShop();renderWeaponsShop();renderInventoryModal();renderCards();renderMissions();
    updateProfileUI();
    syncEditor();resize();requestAnimationFrame(draw);
    log("مرحباً بك مجددًا في قيادة حرب المجرات.");
    setInterval(spawnApproachingEnemy, Math.random() * 15000 + 15000);
  }
}

window.addEventListener("resize",()=> { if(cw&&ch) resize(); });
init();
</script>
