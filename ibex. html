<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COSMIC EMPIRE ULTIMATE | حرب المجرات والملف الشخصي والرتب</title>
<style>
:root {
  --bg:#02040a; --panel:#0b1021; --cyan:#38bdf8;
  --purple:#818cf8; --green:#34d399; --red:#fb7185; --gold:#fbbf24;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:#f1f5f9;
  font-family:Tahoma,Arial,sans-serif;overflow-x:hidden
}
button,input,select{font:inherit}
button{
  background:linear-gradient(135deg,#1e293b,#0f172a);
  border:1px solid #38bdf855;color:white;border-radius:10px;
  padding:10px 14px;cursor:pointer;transition:.2s
}
button:hover{filter:brightness(1.4);transform:translateY(-2px);border-color:var(--cyan)}
button:disabled{opacity:.35;cursor:not-allowed;transform:none}

/* شاشة البداية للفرمتة عند فتح اللعبة */
.intro-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
  z-index: 3000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15px;
  overflow-y: auto;
}
.intro-modal {
  background: linear-gradient(160deg, #0f172a, #020617);
  border: 2px solid var(--cyan);
  border-radius: 24px;
  width: 100%;
  max-width: 480px;
  padding: 26px;
  box-shadow: 0 0 60px rgba(56, 189, 248, 0.4);
  text-align: center;
}
.intro-modal h2 { color: var(--cyan); margin-bottom: 8px; font-size: 21px; }
.intro-modal p { color: #94a3b8; font-size: 13px; margin-bottom: 15px; line-height: 1.6; }

/* نافذة الملف الشخصي العسكري والرتب */
.profile-modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(2, 6, 23, 0.97);
  backdrop-filter: blur(16px);
  z-index: 2500;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
}
.profile-modal-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  max-width: 440px;
  max-height: 860px;
  background: radial-gradient(circle at center, #0c2340 0%, #020617 100%);
  border: 2px solid var(--gold);
  border-radius: 35px;
  box-shadow: 0 0 110px rgba(251, 191, 36, 0.35);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 24px 18px;
  overflow-y: auto;
}

/* نافذة المجرة 3D */
.galaxy-modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(2, 6, 23, 0.97);
  backdrop-filter: blur(16px);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
}
.galaxy-modal-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  max-width: 420px;
  max-height: 860px;
  background: radial-gradient(circle at center, #1e1b4b 0%, #020617 100%);
  border: 2px solid var(--purple);
  border-radius: 35px;
  box-shadow: 0 0 110px rgba(129, 140, 248, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 20px 15px;
  overflow: hidden;
}
.galaxy-header {
  font-size: 18px;
  font-weight: bold;
  color: var(--purple);
  text-shadow: 0 0 15px var(--purple);
  margin-bottom: 5px;
  text-align: center;
}
.camera-controls {
  display: flex;
  gap: 5px;
  margin-bottom: 8px;
  width: 100%;
  justify-content: center;
}
.camera-controls button {
  font-size: 11px;
  padding: 6px 10px;
  background: #312e81;
  border-color: var(--purple);
}
.galaxy-canvas-wrap {
  position: relative;
  width: 100%;
  flex: 1;
  background: #010409;
  border-radius: 20px;
  border: 1.5px solid rgba(129, 140, 248, 0.4);
  overflow: hidden;
  margin: 5px 0;
}
.galaxy-canvas-wrap canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* نافذة ترسانة الأسلحة */
.weapons-modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(2, 6, 23, 0.97);
  backdrop-filter: blur(16px);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
}
.weapons-modal-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  max-width: 420px;
  max-height: 850px;
  background: radial-gradient(circle at center, #4c0519 0%, #020617 100%);
  border: 2px solid var(--red);
  border-radius: 35px;
  box-shadow: 0 0 110px rgba(251, 113, 133, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 22px 15px;
  overflow: hidden;
}
.weapons-list {
  width: 100%;
  flex: 1;
  overflow-y: auto;
  margin: 10px 0;
  padding-right: 5px;
}

/* نافذة "أسلحتي" وزر الإطلاق الفوري */
.inventory-modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(2, 6, 23, 0.97);
  backdrop-filter: blur(16px);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
}
.inventory-modal-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  max-width: 420px;
  max-height: 850px;
  background: radial-gradient(circle at center, #064e3b 0%, #020617 100%);
  border: 2px solid var(--green);
  border-radius: 35px;
  box-shadow: 0 0 110px rgba(52, 211, 153, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 22px 15px;
  overflow: hidden;
}

.top{
  position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;
  align-items:center;gap:8px;padding:12px 16px;
  background:#090d1dee;border-bottom:1px solid #38bdf830;flex-wrap:wrap
}
.logo{font-size:14px;font-weight:bold;color:var(--cyan);letter-spacing:1px}
.coins{color:var(--gold);font-weight:bold;cursor:pointer}
.layout{display:grid;grid-template-columns:260px minmax(0,1fr) 270px;gap:12px;padding:12px}
.panel{
  background:linear-gradient(160deg,#0f172a,#020617);
  border:1px solid #38bdf820;border-radius:15px;padding:14px;min-width:0
}
h3{font-size:14px;color:var(--cyan);margin:4px 0 14px}
h2{font-size:20px;margin:5px 0}
small,.muted{color:#94a3b8;font-size:12px}
.field{margin:12px 0;text-align:right}
.field label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px}
input[type=range]{width:100%;accent-color:var(--cyan)}
input[type=text],select{
  width:100%;padding:9px;border-radius:8px;background:#020617;
  color:white;border:1px solid #334155
}
input[type=color]{width:100%;height:34px;background:transparent;border:0}
.full{width:100%;margin:4px 0}
.danger{border-color:#fb718588;background:#4c0519}
.good{border-color:#34d39988;background:#064e3b}
.canvas-wrap{
  position:relative;overflow:hidden;border:1px solid #38bdf833;
  border-radius:15px;background:#010409;min-height:380px
}
canvas{width:100%;height:380px;display:block;cursor:crosshair}
.overlay{
  position:absolute;top:12px;right:12px;left:12px;
  display:flex;justify-content:space-between;gap:8px;pointer-events:none
}
.pill{background:#020617ee;border:1px solid #38bdf844;border-radius:8px;padding:8px;font-size:11px}
.pill button{pointer-events:auto}
.toolbar{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0}
.toolbar button{flex:1;min-width:75px;font-size:11px}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.planet-card{
  background:#090d1e;border:1px solid #334155;border-radius:12px;
  padding:12px;cursor:pointer;min-width:0
}
.planet-card.active{border-color:var(--cyan);box-shadow:0 0 14px rgba(56,189,248,0.2)}
.mini-planet{
  width:46px;height:46px;border-radius:50%;margin:5px auto 12px;
  box-shadow:inset -10px -8px 18px #0008,0 0 16px rgba(56,189,248,0.2)
}
.card-title{font-size:12px;overflow-wrap:anywhere}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.stat{padding:10px;background:#020617;border-radius:9px}
.stat b{display:block;color:var(--green);font-size:17px;margin-top:4px}
.item{
  padding:10px 0;border-bottom:1px solid #ffffff10;
  display:flex;gap:10px;align-items:center
}
.item-icon{font-size:22px}
.item-info{flex:1;min-width:0}
.item-info b{font-size:12px;display:block}
.item-info small{display:block;margin:4px 0}
.item button{font-size:11px;padding:7px}
.progress{height:5px;background:#1e293b;border-radius:8px;overflow:hidden;margin-top:8px}
.progress div{height:100%;background:var(--green);width:0%;transition:.3s}
.log{font-size:11px;line-height:2;color:#94a3b8;max-height:130px;overflow:auto}
.footer{text-align:center;color:#64748b;padding:18px;font-size:11px}
.notice{
  position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
  background:#0f172a;border:1px solid var(--cyan);padding:12px 18px;
  border-radius:12px;z-index:4000;max-width:90%;font-size:13px;
  box-shadow:0 0 25px rgba(56,189,248,0.3)
}
.hidden{display:none}
@media(max-width:1000px){
 .layout{grid-template-columns:1fr 1fr}
 .main-area{grid-column:1/-1;grid-row:1}
 .left-panel{grid-column:1}
 .right-panel{grid-column:2}
}
@media(max-width:580px){
 .layout{grid-template-columns:1fr;padding:8px}
 .main-area,.left-panel,.right-panel{grid-column:1;grid-row:auto}
 canvas{height:280px}
 .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
 .top{padding:8px}
 .logo{font-size:12px}
}
</style>
</head>
<body>

<!-- شاشة البداية للفرمتة عند فتح اللعبة -->
<div id="introOverlay" class="intro-overlay">
  <div class="intro-modal">
    <h2>🌌 حرب المجرات والملف الشخصي الإمبراطورى</h2>
    <p><b>النظام:</b> تبدأ رحلتك بـ 900 كوينز ورتبة "جندي فضاء متدرب". قم بالقضاء على البوتات واكسب النقاط للترقي في الرتب العسكرية الحقيقية!</p>
    
    <div class="field">
      <label>اسم كوكبك الرئيسي</label>
      <input id="initName" type="text" maxlength="30" value="أوريون الأسطوري">
    </div>
    <div class="field">
      <label>الحجم <span id="initSizeVal">75</span></label>
      <input id="initSize" type="range" min="25" max="100" value="75" oninput="$('initSizeVal').textContent=this.value">
    </div>
    <div class="field">
      <label>درجة الحرارة <span id="initTempVal">24°C</span></label>
      <input id="initTemp" type="range" min="-150" max="500" value="24" oninput="$('initTempVal').textContent=this.value+'°C'">
    </div>
    <div class="field">
      <label>الجاذبية <span id="initGravVal">1.0x</span></label>
      <input id="initGravity" type="range" min="1" max="300" value="100" oninput="$('initGravVal').textContent=(this.value/100).toFixed(1)+'x'">
    </div>
    <div class="field">
      <label>الغلاف الجوي <span id="initAtmVal">75%</span></label>
      <input id="initAtmosphere" type="range" min="0" max="100" value="75" oninput="$('initAtmVal').textContent=this.value+'%'">
    </div>
    <div class="field">
      <label>نسبة المياه <span id="initWaterVal">60%</span></label>
      <input id="initWater" type="range" min="0" max="100" value="60" oninput="$('initWaterVal').textContent=this.value+'%'">
    </div>
    <div class="field">
      <label>لون الكوكب</label>
      <input id="initColor" type="color" value="#38bdf8">
    </div>
    <div class="field">
      <label>نوع التضاريس</label>
      <select id="initTerrain">
        <option value="earth">🌎 أرض خضراء</option>
        <option value="desert">🏜️ صحراء</option>
        <option value="ice">❄️ جليد</option>
        <option value="lava">🌋 حمم بركانية</option>
        <option value="alien">👽 عالم فضائي</option>
      </select>
    </div>

    <button class="full good" style="margin-top:15px;padding:13px;font-size:15px;" onclick="completeIntro()">⚔️ بدء حرب المجرة الآن</button>
  </div>
</div>

<!-- نافذة الملف الشخصي العسكري والرتب -->
<div id="profileModal" class="profile-modal-overlay hidden">
  <div class="profile-modal-container">
    <div class="galaxy-header" style="color:var(--gold);text-shadow:0 0 15px var(--gold);">🎖️ الملف الشخصي والرتب الإمبراطورية</div>
    
    <div style="width:100%;text-align:center;margin:10px 0;">
      <div style="font-size:45px;margin-bottom:5px;" id="profileBadge">🎖️</div>
      <h3 style="color:var(--cyan);font-size:18px;margin:5px 0;" id="profileCommanderName">القائد أوريون</h3>
      <div style="color:var(--gold);font-weight:bold;font-size:15px;" id="profileRankTitle">جندي فضاء متدرب</div>
    </div>

    <div class="panel" style="width:100%;margin:8px 0;background:#020617;">
      <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px;">
        <span>الخبرة الحالية (XP): <b id="profileXp" style="color:var(--green);">0</b></span>
        <span>المطلوبة للرتبة التالية: <b id="profileTargetXp" style="color:var(--cyan);">100</b></span>
      </div>
      <div class="progress" style="height:10px;"><div id="profileProgressBar" style="width:0%;"></div></div>
      <p class="muted" style="text-align:center;font-size:11px;margin-top:8px;" id="profileRemainingText">باقي لك 100 نقطة للترقية للرتبة التالية!</p>
    </div>

    <div class="stats" style="width:100%;margin:10px 0;">
      <div class="stat"><small>البوتات المدمرة</small><b id="statKills" style="color:var(--red);">0</b></div>
      <div class="stat"><small>المستعمرات</small><b id="statPlanetsCount" style="color:var(--cyan);">1</b></div>
      <div class="stat"><small>الرتبة العسكرية</small><b id="statRankLevel" style="color:var(--gold);">1 / 7</b></div>
      <div class="stat"><small>الكوينز</small><b id="statCoinsCount" style="color:var(--gold);">900</b></div>
    </div>

    <button class="full good" onclick="tryUpgradeRank()" id="upgradeRankBtn" style="padding:12px;margin:10px 0;background:linear-gradient(135deg,#b45309,#d97706);">⭐ ترقية الرتبة العسكرية الآن</button>
    <button class="full danger" onclick="closeProfileModal()" style="padding:11px;">إغلاق الملف الشخصي ✕</button>
  </div>
</div>

<!-- نافذة عرض المجرة 3D -->
<div id="galaxyModal" class="galaxy-modal-overlay hidden">
  <div class="galaxy-modal-container">
    <div class="galaxy-header">🌌 خريطة المجرة 3D التفاعلية</div>
    <div class="camera-controls">
      <button onclick="adjustCamera('zoomIn')">➕ تقريب</button>
      <button onclick="adjustCamera('zoomOut')">➖ تبعاد</button>
      <button onclick="adjustCamera('rotateLeft')">◀️ تدوير يسار</button>
      <button onclick="adjustCamera('rotateRight')">تدوير يمين ▶️</button>
    </div>
    <div class="galaxy-canvas-wrap">
      <canvas id="galaxyCanvas"></canvas>
    </div>
    <p class="muted" style="text-align:center;font-size:11px;margin:4px 0;">استكشف عوالم إمبراطوريتك من كل الزوايا.</p>
    <button class="full danger" onclick="closeGalaxyModal()" style="padding:10px;">إغلاق الخريطة ✕</button>
  </div>
</div>

<!-- نافذة ترسانة الأسلحة -->
<div id="weaponsModal" class="weapons-modal-overlay hidden">
  <div class="weapons-modal-container">
    <div class="galaxy-header" style="color:var(--red);text-shadow:0 0 15px var(--red);">⚡ ترسانة أسلحة الإبادة الشاملة</div>
    <div class="weapons-list" id="weaponsListContainer"></div>
    <button class="full danger" onclick="closeWeaponsModal()" style="padding:11px;margin-top:5px;">إغلاق الترسانة ✕</button>
  </div>
</div>

<!-- نافذة "أسلحتي" وزر الإطلاق الفوري -->
<div id="inventoryModal" class="inventory-modal-overlay hidden">
  <div class="inventory-modal-container">
    <div class="galaxy-header" style="color:var(--green);text-shadow:0 0 15px var(--green);">📦 مستودع اسلحتي وأزرار القتل الفوري</div>
    <div class="weapons-list" id="inventoryListContainer"></div>
    <button class="full danger" onclick="closeInventoryModal()" style="padding:11px;margin-top:5px;">إغلاق المستودع ✕</button>
  </div>
</div>

<header class="top">
  <div class="logo">✦ GALAXY WAR</div>
  <div class="coins" onclick="claimBonusCoins()" title="منحة الإمبراطور">🪙 <span id="coins">900</span> كوينز</div>
  <div style="display:flex;gap:5px;flex-wrap:wrap;">
    <button onclick="openProfileModal()" style="background:linear-gradient(135deg,#b45309,#d97706);">👤 الملف الشخصي</button>
    <button onclick="openInventoryModal()" style="background:linear-gradient(135deg,#065f46,#047857);">📦 اسلحتي</button>
    <button onclick="openWeaponsModal()" style="background:linear-gradient(135deg,#991b1b,#dc2626);">⚡ الترسانة</button>
    <button onclick="openGalaxyModal()" style="background:linear-gradient(135deg,#4f46e5,#7c3aed);">🌌 مجرة 3D</button>
    <button onclick="resetGameCompletely()" style="background:#7f1d1d;" title="فرمتة اللعبة">🔄</button>
  </div>
</header>

<div class="layout">
  <aside class="panel left-panel">
    <h3>🪐 مختبر تطوير العوالم</h3>
    <div class="field">
      <label>اسم الكوكب</label>
      <input id="planetName" type="text" maxlength="30" value="" onchange="renamePlanet()">
    </div>
    <div class="field">
      <label>حجم الكوكب <span id="sizeVal">70</span></label>
      <input id="size" type="range" min="25" max="100" value="70" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>درجة الحرارة <span id="tempVal">22°C</span></label>
      <input id="temp" type="range" min="-150" max="500" value="22" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>الجاذبية <span id="gravVal">1.0x</span></label>
      <input id="gravity" type="range" min="1" max="300" value="100" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>الغلاف الجوي <span id="atmVal">70%</span></label>
      <input id="atmosphere" type="range" min="0" max="100" value="70" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>نسبة المياه <span id="waterVal">55%</span></label>
      <input id="water" type="range" min="0" max="100" value="55" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>لون الكوكب</label>
      <input id="planetColor" type="color" value="#38bdf8" oninput="updatePlanet()">
    </div>
    <div class="field">
      <label>نوع التضاريس</label>
      <select id="terrain" onchange="updatePlanet()">
        <option value="earth">🌎 أرض خضراء</option>
        <option value="desert">🏜️ صحراء</option>
        <option value="ice">❄️ جليد</option>
        <option value="lava">🌋 حمم بركانية</option>
        <option value="alien">👽 عالم فضائي</option>
      </select>
    </div>
    <button class="full good" onclick="createPlanet()">＋ إنشاء مستعمرة جديدة (100 🪙)</button>
    <button class="full" onclick="randomPlanet()">🎲 توليد عالم عشوائي</button>
    <button class="full" onclick="startExpedition()" style="background:linear-gradient(135deg,#0284c7,#0369a1)">🛰️ بعثة تنقيب فضائي</button>
    <p class="muted">التعديلات تطبق فوراً على الكوكب المحدد.</p>
  </aside>

  <main class="main-area">
    <div class="canvas-wrap">
      <canvas id="space"></canvas>
      <div class="overlay">
        <div class="pill">⚔️ الأعداء: <span id="enemyCount">0</span> | الرتبة: <span id="currentRankDisplay">جندي فضاء متدرب</span></div>
        <div class="pill" id="status">افتح (الملف الشخصي) لمتابعة رتبتك العسكرية أو (أسلحتي) للقتل الفوري</div>
      </div>
    </div>

    <div class="toolbar">
      <button onclick="setTool('select')">🖱️ تحديد</button>
      <button onclick="setTool('meteor')">☄️ نيزك</button>
      <button onclick="setTool('bomb')">💥 قنبلة</button>
